# Cloud runtime template (copy to .env.cloud and fill secrets)

# Select bot entrypoint: scdlbot | flacbot
BOT_MODE="scdlbot"

# Required for both bots
TG_BOT_TOKEN="replace_with_real_bot_token"
TG_BOT_API="https://api.telegram.org"
LOGLEVEL="INFO"

# Required owner chat id for scdlbot alerts/permissions
TG_BOT_OWNER_CHAT_ID="123456789"

# scdlbot webhook settings (recommended for cloud web services)
WEBHOOK_ENABLE="1"
WEBHOOK_APP_URL_ROOT="https://your-cloud-service.example.com"
HOST="0.0.0.0"
PORT="5000"
WEBHOOK_SECRET_TOKEN="replace_with_random_secret"

# Optional scdlbot settings
WORKERS="2"
EXECUTOR_KIND="thread"
DL_TIMEOUT="600"
MAX_TG_FILE_SIZE="45_000_000"
MAX_CONVERT_FILE_SIZE="80_000_000"
QUALITY_MIN_BITRATE_KBPS="320"
PREFER_LOSSLESS="1"
ENABLE_CROSS_PLATFORM_SEARCH="1"
ENABLE_WEB_FALLBACK="1"
FALLBACK_MAX_CANDIDATES="8"
YOUTUBE_MIN_HEIGHT="1080"

# Optional flacbot settings (Spotify search provider)
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""
