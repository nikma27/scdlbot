[Unit]
Description=scdlbot Telegram bot service
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
NotifyAccess=all
User=scdlbot
Group=scdlbot
WorkingDirectory=/opt/scdlbot
EnvironmentFile=/etc/scdlbot/scdlbot.env
Environment=PATH=/home/scdlbot/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/env poetry run python -m scdlbot
ExecStartPre=/usr/bin/env poetry run python -m scdlbot.config_validation --preflight
Restart=always
RestartSec=5
TimeoutStopSec=45
KillSignal=SIGINT
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
