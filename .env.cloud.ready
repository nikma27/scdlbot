# Готовый конфиг для ephemeral cloud-среды
# 1) Скопируй в .env.cloud: cp .env.cloud.ready .env.cloud
# 2) Заполни только три поля ниже (остальное — безопасные дефолты)

### Bot mode
BOT_MODE="scdlbot"

### Telegram / API — ОБЯЗАТЕЛЬНО ЗАПОЛНИТЬ:
TG_BOT_TOKEN=""
TG_BOT_OWNER_CHAT_ID=""
TG_BOT_API="https://api.telegram.org"
TG_BOT_API_LOCAL_MODE="0"

### Runtime / executor
WORKERS="2"
EXECUTOR_KIND="thread"
DL_TIMEOUT="600"
CHECK_URL_TIMEOUT="30"
COMMON_CONNECTION_TIMEOUT="10"
RESTART_COOLDOWN_SECONDS="30"
SHUTDOWN_GRACE_SECONDS="10"

### Admission limits / anti-flood
MAX_ACTIVE_JOBS_PER_USER="2"
MAX_ACTIVE_JOBS_PER_CHAT="4"
MAX_GLOBAL_ACTIVE_JOBS="8"
USER_REQUEST_COOLDOWN_SECONDS="3"
CHAT_REQUEST_COOLDOWN_SECONDS="1"
BURST_REQUEST_LIMIT="5"
BURST_WINDOW_SECONDS="20"

### Search / fallback quality
QUALITY_MIN_BITRATE_KBPS="320"
PREFER_LOSSLESS="1"
ENABLE_CROSS_PLATFORM_SEARCH="1"
ENABLE_WEB_FALLBACK="1"
FALLBACK_MAX_CANDIDATES="8"
YOUTUBE_MIN_HEIGHT="1080"
SEARCH_RESULT_LIMIT="5"
SEARCH_CHOICE_TTL_SECONDS="900"
PERSISTENCE_EPHEMERAL_TTL_SECONDS="3600"

### Storage / temp files (ephemeral — в /tmp, не сохраняется между рестартами)
CHAT_STORAGE="/tmp/scdlbot.pickle"
CHAT_STORAGE_FALLBACK="/tmp/scdlbot.pickle"
DL_DIR="/tmp/scdlbot"
DL_DIR_FALLBACK="/tmp/scdlbot"
MAX_TG_FILE_SIZE="45_000_000"
MAX_CONVERT_FILE_SIZE="80_000_000"
TEMP_FILE_TTL_SECONDS="86400"
DL_DIR_MAX_BYTES="0"
DL_DIR_MAX_FILE_COUNT="0"
COOKIES_FILE=""
RESTART_STATE_FILE="/tmp/scdlbot_restart_ts"

### Observability / logging
LOGLEVEL="INFO"
LOG_JSON="0"
METRICS_HOST="127.0.0.1"
METRICS_PORT="8000"
SYSLOG_ADDRESS=""
HOSTNAME="cloud-scdlbot"

### Healthcheck endpoint
HEALTHCHECK_ENABLE="1"
HEALTHCHECK_HOST="0.0.0.0"
HEALTHCHECK_PORT="8080"

### Webhook — для первого запуска используй POLLING (см. ниже)
### POLLING (рекомендуется для первого запуска): не нужен публичный URL
WEBHOOK_ENABLE="0"
### WEBHOOK_APP_URL_ROOT — заполни только если WEBHOOK_ENABLE="1"
WEBHOOK_APP_URL_ROOT=""
WEBHOOK_APP_URL_PATH=""
WEBHOOK_SECRET_TOKEN=""
HOST="0.0.0.0"
PORT="5000"

### Optional network controls
PROXIES=""
SOURCE_IPS=""
NO_FLOOD_CHAT_IDS=""
WHITELIST_DOMAINS=""
BLACKLIST_DOMAINS=""
WHITELIST_CHATS=""
BLACKLIST_CHATS=""

### flacbot (если BOT_MODE=flacbot)
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""
