# FLAC Music Search Bot - конфигурация
# Скопируйте в .env и заполните значения

# Обязательно: токен от @BotFather
TG_BOT_TOKEN="your_telegram_bot_token"

# Опционально: кастомный Telegram API (по умолчанию api.telegram.org)
# TG_BOT_API="https://api.telegram.org"

# Spotify API - для поиска по каталогу (получить на https://developer.spotify.com/dashboard)
# Без них будет работать только MusicBrainz + Bandcamp
SPOTIFY_CLIENT_ID="your_spotify_client_id"
SPOTIFY_CLIENT_SECRET="your_spotify_client_secret"

# Логирование
LOGLEVEL="INFO"
