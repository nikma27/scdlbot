# FLAC Music Search Bot - конфигурация
# Скопируйте в .env и заполните значения

### Telegram/API
TG_BOT_TOKEN="your_telegram_bot_token"
TG_BOT_API="https://api.telegram.org"
TG_BOT_API_LOCAL_MODE="0"

### Runtime
BOT_MODE="flacbot"
WORKERS="2"
COMMON_CONNECTION_TIMEOUT="10"
DL_TIMEOUT="300"
CHECK_URL_TIMEOUT="30"

### Spotify (optional, improves search quality)
SPOTIFY_CLIENT_ID="your_spotify_client_id"
SPOTIFY_CLIENT_SECRET="your_spotify_client_secret"

### Logging / observability
LOGLEVEL="INFO"
LOG_JSON="0"
METRICS_HOST="127.0.0.1"
METRICS_PORT="8000"
HEALTHCHECK_ENABLE="0"
HEALTHCHECK_HOST="127.0.0.1"
HEALTHCHECK_PORT="8080"
